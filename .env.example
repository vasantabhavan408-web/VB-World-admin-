# Server Port
PORT=4000
NODE_ENV=production

# Database Connection (PostgreSQL - Neon, Supabase, Render PostgreSQL, etc.)
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"

# JWT Secret for Authentication
JWT_SECRET="your-super-secret-jwt-key"

# AWS S3 Storage (Optional - falls back to local storage if omitted)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET_NAME=""
